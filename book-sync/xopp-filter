#!/usr/bin/env python3
"""xopp-filter -- git's filter=xopp for book page files (README "Merge drivers").

    xopp-filter clean      stdin -> stdout: gzip -> the plain XML inside (what git stores)
    xopp-filter smudge     stdin -> stdout: plain XML -> gzip, mtime 0 (what X0urnal++ reads)
    xopp-filter process    git's long-running filter protocol (filter.<driver>.process)

Why plain XML in git: gzip output changes completely when one stroke changes, so git could not
delta it and every save of a page would cost the whole page again. Plain XML deltas to a few
hundred bytes, and the merge driver gets text it can parse without unpacking.

Why `process` as well as clean/smudge: git starts a clean/smudge command once PER FILE. A fresh
clone of a big book (hundreds of pages) would start Python hundreds of times, which on a small
ARM board is many seconds. With `process` git starts this once per git command and streams every
file through it. `book-sync setup` configures all three; git uses `process` when it is set.

Both directions are deterministic (same bytes in, same bytes out) and never refuse: a page whose
gzip is broken is passed through unchanged, so a bad file is stored as it is, never lost.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))   # booklib beside the real file

import booklib  # noqa: E402

MAX_PKT = 65516   # largest pkt-line payload git sends and accepts (LARGE_PACKET_DATA_MAX)


def _read_exact(f, n):
    buf = b""
    while len(buf) < n:
        chunk = f.read(n - len(buf))
        if not chunk:
            raise EOFError
        buf += chunk
    return buf


def _read_pkt(f):
    """One pkt-line: bytes, or None for a flush packet (0000). EOFError when git closed the pipe."""
    head = f.read(4)
    if not head:
        raise EOFError
    if len(head) < 4:
        head += _read_exact(f, 4 - len(head))
    n = int(head, 16)
    if n < 4:          # 0000 flush (0001/0002 do not occur in the filter protocol)
        return None
    return _read_exact(f, n - 4)


def _read_text_list(f):
    out = []
    while True:
        p = _read_pkt(f)
        if p is None:
            return out
        out.append(p.decode("utf-8", "replace").rstrip("\n"))


def _read_content(f):
    parts = []
    while True:
        p = _read_pkt(f)
        if p is None:
            return b"".join(parts)
        parts.append(p)


def _write_pkt(o, data):
    o.write(b"%04x" % (len(data) + 4))
    o.write(data)


def _flush(o):
    o.write(b"0000")


def run_process(i, o):
    """The long-running filter protocol, version 2 (gitprotocol-common / gitattributes(5))."""
    hello = _read_text_list(i)
    if "git-filter-client" not in hello or "version=2" not in hello:
        sys.stderr.write("xopp-filter: git did not offer filter protocol version 2\n")
        return 1
    _write_pkt(o, b"git-filter-server\n")
    _write_pkt(o, b"version=2\n")
    _flush(o)
    o.flush()          # git waits for this before it sends the capabilities
    offered = _read_text_list(i)
    for cap in ("capability=clean", "capability=smudge"):
        if cap in offered:
            _write_pkt(o, (cap + "\n").encode())
    _flush(o)
    o.flush()
    while True:
        try:
            meta = _read_text_list(i)
        except EOFError:
            return 0
        if not meta:
            continue
        info = dict(x.split("=", 1) for x in meta if "=" in x)
        content = _read_content(i)
        cmd = info.get("command")
        try:
            if cmd == "clean":
                out = booklib.clean_bytes(content)
            elif cmd == "smudge":
                out = booklib.smudge_bytes(content)
            else:
                raise ValueError("unknown command %r" % cmd)
        except Exception as e:  # never take git down with us: report and let git keep the input
            sys.stderr.write("xopp-filter: %s: %s\n" % (info.get("pathname", "?"), e))
            _write_pkt(o, b"status=error\n")
            _flush(o)
            o.flush()
            continue
        _write_pkt(o, b"status=success\n")
        _flush(o)
        for k in range(0, len(out), MAX_PKT):
            _write_pkt(o, out[k:k + MAX_PKT])
        _flush(o)
        _flush(o)          # empty list after the content: "status stays success"
        o.flush()


def main(argv):
    mode = argv[1] if len(argv) > 1 else ""
    if mode == "process":
        try:
            return run_process(sys.stdin.buffer, sys.stdout.buffer)
        except EOFError:
            return 0
    if mode in ("clean", "smudge"):
        data = sys.stdin.buffer.read()
        out = booklib.clean_bytes(data) if mode == "clean" else booklib.smudge_bytes(data)
        sys.stdout.buffer.write(out)
        sys.stdout.buffer.flush()
        return 0
    sys.stderr.write("usage: xopp-filter clean|smudge|process\n")
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
