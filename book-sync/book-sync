    "-c", "gc.autoDetach=false",
]

SSH_COMMAND = "ssh -o ConnectTimeout=15 -o BatchMode=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=4"

# ssh/git messages that mean "the server could not be reached" (state offline) rather than "the
# server said no" (state error). LC_ALL=C keeps them in English.
OFFLINE_SIGNS = (
    "could not resolve hostname", "name or service not known", "temporary failure in name resolution",
    "connection timed out", "operation timed out", "timed out", "connection refused",
    "network is unreachable", "no route to host", "host is down", "connection closed by",
    "connection reset", "kex_exchange_identification", "broken pipe", "connect to host",
    "could not resolve host",
)
