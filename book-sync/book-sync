class Failure(Exception):
    """Ends the command with state error and this message."""


class Interrupted(Exception):
    pass


STOP = []   # the signal number, once SIGTERM/SIGHUP/SIGINT arrived


class Blocked(Exception):
    """git would not merge because local, uncommitted files are in the way (a page mid-write)."""


class GitError(Failure):
    def __init__(self, args, r):
        err = (r.stderr or b"").decode("utf-8", "replace").strip().splitlines()
        tail = " / ".join(x.strip() for x in err[-3:] if x.strip()) or "exit %d" % r.returncode
        super().__init__("git %s: %s" % (args[0] if args else "", tail))
        self.stderr = "\n".join(err)
        self.returncode = r.returncode


# ---- git --------------------------------------------------------------------------------------


class Git:
    def __init__(self, top):
        self.top = top
        self._ssh = None

    @staticmethod
    def env(extra=None):
        e = dict(os.environ)
        # whatever git context book-sync was started from must not redirect it
        for k in ("GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE", "GIT_OBJECT_DIRECTORY", "GIT_COMMON_DIR",
                  "GIT_PREFIX", "GIT_NAMESPACE", "GIT_CEILING_DIRECTORIES", "LANGUAGE"):
            e.pop(k, None)
        e.update({"GIT_TERMINAL_PROMPT": "0", "LC_ALL": "C", "GIT_MERGE_AUTOEDIT": "no", "GIT_EDITOR": "true"})
        if extra:
            e.update(extra)
        return e

    def ssh_opts(self):
        """Fail fast and never prompt when the server is away -- unless an own ssh command is
        configured (GIT_SSH_COMMAND, core.sshCommand), which then wins."""
        if self._ssh is None:
            self._ssh = []
            if not os.environ.get("GIT_SSH_COMMAND") and not os.environ.get("GIT_SSH"):
                r = self.run("config", "--get", "core.sshCommand", check=False)
                if r.returncode != 0 or not r.stdout.strip():
                    self._ssh = ["-c", "core.sshCommand=" + SSH_COMMAND]
        return self._ssh

    def run(self, *args, check=True, input=None, extra_env=None, timeout=600, network=False):
        """Run one git command to the end. A stop signal (X0urnal++ closing, SIGTERM) is honoured
        BETWEEN git commands, never by killing one mid-way: a git killed with SIGKILL leaves
        .git/index.lock behind and every later sync fails. Network commands, which can take
        minutes, get a plain SIGTERM instead, on which git removes its own lock files."""
        if STOP:
            raise Interrupted("stopped by signal %d" % STOP[0])
        cmd = ["git"]
        if self.top:
            cmd += ["-C", self.top]
        cmd += GIT_OPTS
        if network:
            cmd += self.ssh_opts()
        cmd += list(args)
        p = subprocess.Popen(cmd, stdin=subprocess.PIPE if input is not None else subprocess.DEVNULL,
                             stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=self.env(extra_env), **NO_WINDOW)
        deadline = time.monotonic() + timeout
        first = True
        while True:
            try:
                out, err = p.communicate(input=input if first else None, timeout=0.5)
                break
            except subprocess.TimeoutExpired:
                first = False
                late = time.monotonic() > deadline
                if late or (STOP and network):
                    p.terminate()
                    try:
                        p.communicate(timeout=15)
                    except subprocess.TimeoutExpired:
                        p.kill()
                        p.communicate()
                    if late:
                        raise subprocess.TimeoutExpired(cmd, timeout)
                    raise Interrupted("stopped by signal %d" % STOP[0])
        r = subprocess.CompletedProcess(cmd, p.returncode, out, err)
        if check and r.returncode != 0:
            raise GitError(list(args), r)
        return r

    def out(self, *args, **kw):
        return self.run(*args, **kw).stdout.decode("utf-8", "replace")

    def ok(self, *args, **kw):
        return self.run(*args, check=False, **kw).returncode == 0


def classify(stderr):
    s = (stderr or "").lower()
    if any(x in s for x in OFFLINE_SIGNS):
        return "offline"
    return "error"


def last_line(stderr):
    lines = [x.strip() for x in (stderr or "").splitlines() if x.strip()]
    meaningful = [x for x in lines if not x.lower().startswith(("hint:", "please make sure", "and the repository exists"))]
    return (meaningful or lines or ["no message"])[-1]


def why(stderr):
    """The line that says what went wrong: for an unreachable server that is ssh's line ("connect to
    host ... Network is unreachable"), not git's generic "Could not read from remote repository"."""
    for line in (stderr or "").splitlines():
        if any(x in line.lower() for x in OFFLINE_SIGNS):
            return line.strip()
    return last_line(stderr)


def is_local_url(url):
    # and on Windows a drive path (C:\... or C:/...) or a share (\\host\...): a folder, not "host:path"
    return url.startswith(("/", "./", "../", "file://", "\\\\")) or (len(url) > 2 and url[1] == ":" and url[2] in "\\/")


# ---- the book ---------------------------------------------------------------------------------


class Book:
    def __init__(self, path):
        self.path = os.path.abspath(path)
        self.git = Git(self.path)
        self.device = bl.device_name()

    # paths
    def p(self, rel):
        return os.path.join(self.path, rel)

    @property
    def git_dir(self):
        return self.p(".git")

    @property
    def state_dir(self):
        return self.p(bl.STATE_DIR)

    def is_repo(self):
        return os.path.exists(os.path.join(self.git_dir, "HEAD"))

    # refs
    def head(self):
        return self.rev("HEAD")

    def rev(self, ref):
        r = self.git.run("rev-parse", "-q", "--verify", ref + "^{commit}", check=False)
        return r.stdout.decode().strip() if r.returncode == 0 else None

    def branch(self):
        r = self.git.run("symbolic-ref", "--short", "-q", "HEAD", check=False)
        b = r.stdout.decode().strip()
        if not b:
            raise Failure("the book is not on a branch (detached HEAD); fix it with git first")
        return b

    def upstream(self):
        return self.rev("refs/remotes/origin/" + self.branch())

    def remote(self):
        r = self.git.run("config", "--get", "remote.origin.url", check=False)
        return r.stdout.decode().strip() or None

    def merging(self):
        return os.path.exists(os.path.join(self.git_dir, "MERGE_HEAD"))

    def is_ancestor(self, a, b):
        return self.git.ok("merge-base", "--is-ancestor", a, b)

    def author(self, sha):
        r = self.git.run("log", "-1", "--format=%an", sha, check=False)
        return r.stdout.decode().strip() or "the server"

    def count(self, rng):
        r = self.git.run("rev-list", "--count", rng, check=False)
        try:
            return int(r.stdout.decode().strip())
        except ValueError:
            return 0

    def ahead(self):
        head = self.head()
        if head is None:
            return 0
        up = self.upstream() if self.remote() else None
        return self.count("%s..HEAD" % up if up else "HEAD")

    def blob(self, spec):
        r = self.git.run("cat-file", "blob", spec, check=False)
        return r.stdout if r.returncode == 0 else None

    def diff_names(self, a, b):
        """Every path that differs between two commits: modified, added and deleted, with renames
        split into the old and the new path (X0urnal++ needs both)."""
        if a == b:
            return set()
        if a is None:
            out = self.git.out("ls-tree", "-r", "--name-only", "-z", b)
        else:
            out = self.git.out("diff", "--name-only", "--no-renames", "-z", a, b)
        return {x for x in out.split("\0") if x}

    # local state
    def read_state(self):
        try:
            with open(os.path.join(self.state_dir, STATE_FILE), encoding="utf-8") as f:
                return json.load(f)
        except (OSError, ValueError):
            return {}

    def write_state(self, **kw):
        st = self.read_state()
        st.update(kw)
        bl.write_atomic(os.path.join(self.state_dir, STATE_FILE), (json.dumps(st, indent=1) + "\n").encode())


def resolve_book(arg):
    p = os.path.abspath(os.path.expanduser(arg))
    if os.path.isdir(p):
        return p
    if os.path.isfile(p):
        raise Failure("%s is a file (a zip .book?); X0urnal++ imports it into a folder book first" % arg)
    if "/" not in arg:
        nb = bl.notebooks_dir()
        for cand in (os.path.join(nb, arg), os.path.join(nb, arg + ".book")):
            if os.path.isdir(cand):
                return cand
    raise Failure("no such book: %s" % arg)


@contextlib.contextmanager
def locked(book):
    """flock on .git/book-sync.lock, waiting up to 30 s (README "Locking"). X0urnal++, sync-all
    and the OneNote import all go through this, so git never runs twice in one book. The lock
    file is opened close-on-exec so no git child keeps it after we are gone. The lock lives in
    .git, so a folder that is not a repo yet is made one first (git init is safe to repeat)."""
    ensure_repo(book)
    fd = os.open(os.path.join(book.git_dir, LOCK_NAME), os.O_RDWR | os.O_CREAT | O_PRIVATE, 0o644)
    deadline = time.monotonic() + LOCK_WAIT
    held = False
    try:
        while True:
            if try_lock(fd):
                held = True
                break
            else:
                if time.monotonic() >= deadline:
                    raise Failure("busy: something else has held this book's lock for %g s; try again" % LOCK_WAIT)
                if STOP:
                    raise Interrupted("stopped by signal %d while waiting for the lock" % STOP[0])
                time.sleep(0.05)
        clear_stale_git_locks(book)
        yield
    finally:
        if held:
            unlock(fd)
        os.close(fd)   # closing the descriptor releases the lock too


STALE_LOCKS = ("index.lock", "HEAD.lock", "config.lock", "packed-refs.lock", "MERGE_HEAD.lock", "ORIG_HEAD.lock")


def clear_stale_git_locks(book, age=60):
    """git's own lock files that a crashed or killed git left behind. With our flock held no
    book-sync is running git here, so a git lock file older than a minute belongs to nobody;
    left alone it would make every later sync fail with "index.lock exists". X0urnal++'s
    .git/x0urnal.lock and our book-sync.lock are not touched."""
    now = time.time()
    cands = [os.path.join(book.git_dir, n) for n in STALE_LOCKS]
    for sub in ("refs/heads", "refs/remotes/origin"):
        d = os.path.join(book.git_dir, sub)
        if os.path.isdir(d):
            cands += [os.path.join(d, n) for n in os.listdir(d) if n.endswith(".lock")]
    for p in cands:
        try:
            if now - os.stat(p).st_mtime > age:
                os.unlink(p)
                sys.stderr.write("book-sync: removed a stale %s\n" % os.path.relpath(p, book.path))
        except OSError:
            pass


def lock_busy(book):
    """True if someone holds the lock right now (status uses this; it never waits)."""
    path = os.path.join(book.git_dir, LOCK_NAME)
    if not os.path.exists(path):
        return False
    try:
        fd = os.open(path, os.O_RDWR | O_PRIVATE)
    except OSError:
        return False
    try:
        if try_lock(fd):
            unlock(fd)
            return False
        return True
    finally:
        os.close(fd)


